# Merge Safely GitHub App configuration. Copy to .env and fill in. Never commit .env.

# The App's numeric id (GitHub App settings page, "About").
GITHUB_APP_ID=
# Private key: docker-compose.yml mounts ./github-app.pem and sets GITHUB_APP_PRIVATE_KEY_FILE.
# Alternatively paste the PEM here (newlines may be written as \n):
# GITHUB_APP_PRIVATE_KEY=
# The webhook secret you entered on the App (openssl rand -hex 32).
GITHUB_WEBHOOK_SECRET=

# Required. Encrypts every stored provider key. Generate with: openssl rand -hex 32
# Keep a copy outside the data volume and its backups; losing it means re-connecting every provider.
MERGE_SAFELY_MASTER_KEY=

# Required. Bearer token for /setup and the admin endpoints. Generate with: openssl rand -hex 24
SETUP_TOKEN=

# Public base URL of this service (used for check-run "Details" links), e.g. https://merge-safely.example.com
PUBLIC_URL=

# Optional: Slack incoming webhook for escalations, verdict notices and budget alerts.
SLACK_WEBHOOK_URL=

# Optional tuning.
# CONCURRENCY=2          # reviews running at once
# LOG_LEVEL=info         # debug | info | warn | error
# PORT=8080
# MERGE_SAFELY_DATA_DIR=/data
# SHUTDOWN_DEADLINE_MS=25000
# GITHUB_API_URL=https://ghe.example.com/api/v3   # GitHub Enterprise Server only
