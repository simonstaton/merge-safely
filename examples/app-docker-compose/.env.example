# Merge Safely GitHub App configuration. Copy to .env and fill in. Never commit .env.

# The App's numeric ID, from the App's settings page.
GITHUB_APP_ID=

# The App's private key (PEM). Keep the quotes; the value spans several lines.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# The webhook secret you set on the App. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Encrypts stored connection secrets. Generate with: openssl rand -hex 32
# Back it up separately from the database. Losing it means re-connecting every provider.
MERGE_SAFELY_MASTER_KEY=

# Set in docker-compose.yml; override here if needed.
# DATABASE=/data/merge-safely.db
# PORT=3000
