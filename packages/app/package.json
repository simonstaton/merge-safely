{
  "name": "@merge-safely/app",
  "version": "0.1.0",
  "description": "Self-hosted GitHub App service: webhooks, queue, setup page, encrypted connections",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@merge-safely/core": "0.1.0",
    "@merge-safely/lenses": "0.1.0",
    "@merge-safely/registry": "0.1.0",
    "@merge-safely/providers": "0.1.0",
    "@merge-safely/tools": "0.1.0",
    "@merge-safely/workspace-local": "0.1.0",
    "@merge-safely/provider-anthropic": "0.1.0",
    "@merge-safely/provider-openai": "0.1.0",
    "@merge-safely/provider-gemini": "0.1.0",
    "@merge-safely/provider-compatible": "0.1.0",
    "@merge-safely/github": "0.1.0",
    "@merge-safely/store-sqlite": "0.1.0",
    "@merge-safely/escalation-slack": "0.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "better-sqlite3": "^11.5.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/auth-app": "^7.1.0"
  },
  "bin": {
    "merge-safely-app": "./dist/main.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@merge-safely/testkit": "0.1.0"
  }
}
