{
  "name": "merge-safely-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Adversarial, risk-tiered, model-agnostic AI code review that produces a commit-pinned merge signal for GitHub PRs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.12"
  }
}
